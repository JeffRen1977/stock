STOCK_API_PROVIDER=yahoo
PRIMARY_MARKET_PROVIDER=yahoo
FALLBACK_MARKET_PROVIDERS=stooq,yahoo
PROVIDER_TIMEOUT_SECONDS=8
FINNHUB_API_KEY=your_optional_finnhub_key
QUOTE_CACHE_TTL_SECONDS=300
NEWS_CACHE_TTL_SECONDS=21600
HISTORY_CACHE_TTL_SECONDS=86400

WHATSAPP_TO=+1xxxxxxxxxx,+1yyyyyyyyyy

WATCHLIST=AAPL,MSFT,NVDA,TSLA
TOP_GAINERS_LIMIT=5
NEWS_ITEMS_PER_STOCK=2
API_REQUEST_DELAY_SECONDS=13
SAVE_DAILY_MEMORY=true
ENABLE_MEMORY_RETRIEVAL=false
MEMORY_DIR=memory/daily_stock
DATABASE_PATH=data/stock_agent.sqlite3
GENERATE_CHART_WIDGET=true
CHART_SYMBOL=NVDA
DASHBOARD_DIR=dashboard
ENABLE_SEC_INGESTION=true
SEC_USER_AGENT="OpenClawStockAgent/0.1 contact@example.com"
SEC_FILINGS_LIMIT=5
TIMEZONE=America/Los_Angeles
SEND_TIME=13:30
